# Скопируйте эти значения в Render → Environment (НЕ коммитьте .env с
# реальными ключами в открытый репозиторий — sandbox-ключи не секретны,
# боевые (не sandbox) — секретны).

# Это тестовые (sandbox) ключи LiqPay — ими можно проверить весь процесс
# покупки БЕЗ реальных денег. Когда протестируете и получите боевые ключи
# в личном кабинете liqpay.ua, замените ими и уберите LIQPAY_SANDBOX.
LIQPAY_PUBLIC_KEY=sandbox_i38801990261
LIQPAY_PRIVATE_KEY=sandbox_pLBZ2gEoCv5bGbee9j5jjl433Y5MsLPrWrHJkZEh
LIQPAY_SANDBOX=1

PREMIUM_PRICE_UAH=50

# Уже известные вам значения — те же, что и в email-admin-server:
FIREBASE_SERVICE_ACCOUNT=<весь JSON сервисного аккаунта одной строкой>
FIREBASE_DATABASE_URL=https://chatex-8b404-default-rtdb.firebaseio.com
ALLOWED_ORIGIN=https://chatex-8b404.web.app

# Заполнить ПОСЛЕ первого деплоя — Render сам покажет вам этот адрес:
SERVER_URL=https://<ваш-сервис>.onrender.com
